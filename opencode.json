      "template": "{file:.opencode/commands/ecc-orchestrate.md}\n\n$ARGUMENTS",
      "agent": "planner",
      "subtask": true
    },
    "ecc-learn": {
      "description": "Extract patterns and learnings from session",
      "template": "{file:.opencode/commands/ecc-learn.md}\n\n$ARGUMENTS"
    },
    "ecc-checkpoint": {
      "description": "Save verification state and progress",
