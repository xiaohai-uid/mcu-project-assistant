{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".opencode/instructions/ecc-INSTRUCTIONS.md"
  ],
  "skills": {
    "paths": [
      ".opencode/skills/openspec-propose",
      ".opencode/skills/openspec-explore",
      ".opencode/skills/openspec-apply-change",
      ".opencode/skills/openspec-archive-change",
      ".opencode/skills/openspec-sync-specs",
      ".opencode/skills/openspec-new-change",
      ".opencode/skills/openspec-continue-change",
      ".opencode/skills/openspec-ff-change",
      ".opencode/skills/openspec-verify-change",
      ".opencode/skills/openspec-bulk-archive-change",
      ".opencode/skills/openspec-onboard",
      ".opencode/skills/ecc"
    ]
  },
  "command": {
    "ecc-plan": {
      "description": "Create a detailed implementation plan for complex features",
      "template": "{file:.opencode/commands/ecc-plan.md}\n\n$ARGUMENTS",
      "agent": "planner",
      "subtask": true
    },
    "ecc-tdd": {
      "description": "Enforce TDD workflow with 80%+ test coverage",
      "template": "{file:.opencode/commands/ecc-tdd.md}\n\n$ARGUMENTS",
      "agent": "tdd-guide",
      "subtask": true
    },
    "ecc-code-review": {
      "description": "Review code for quality, security, and maintainability",
      "template": "{file:.opencode/commands/ecc-code-review.md}\n\n$ARGUMENTS",
      "agent": "code-reviewer",
      "subtask": true
    },
    "ecc-security": {
      "description": "Run comprehensive security review",
      "template": "{file:.opencode/commands/ecc-security.md}\n\n$ARGUMENTS",
      "agent": "security-reviewer",
      "subtask": true
    },
    "ecc-build-fix": {
      "description": "Fix build and TypeScript errors with minimal changes",
      "template": "{file:.opencode/commands/ecc-build-fix.md}\n\n$ARGUMENTS",
      "agent": "build-error-resolver",
      "subtask": true
    },
    "ecc-e2e": {
      "description": "Generate and run E2E tests with Playwright",
      "template": "{file:.opencode/commands/ecc-e2e.md}\n\n$ARGUMENTS",
      "agent": "e2e-runner",
      "subtask": true
