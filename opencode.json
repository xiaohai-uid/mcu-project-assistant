    },
    "ecc-promote": {
      "description": "Promote project instincts to global scope",
      "template": "{file:.opencode/commands/ecc-promote.md}\n\n$ARGUMENTS"
    },
    "ecc-projects": {
      "description": "List known projects and instinct stats",
      "template": "{file:.opencode/commands/ecc-projects.md}\n\n$ARGUMENTS"
    },
    "ecc-harness-audit": {
      "description": "Audit agent harness configuration",
      "template": "{file:.opencode/commands/ecc-harness-audit.md}\n\n$ARGUMENTS"
    },
    "ecc-quality-gate": {
      "description": "Run quality gate checks",
      "template": "{file:.opencode/commands/ecc-quality-gate.md}\n\n$ARGUMENTS"
    },
    "ecc-security-scan": {
      "description": "Run security scan",
      "template": "{file:.opencode/commands/ecc-security-scan.md}\n\n$ARGUMENTS"
