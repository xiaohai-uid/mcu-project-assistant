# MCU Project Assistant - Environment Configuration
# Copy this file to .env and adjust values for your environment.
# All variables have safe development defaults — the project runs out of the box.

# ─── Database ───────────────────────────────────────────────
POSTGRES_PASSWORD=mcu_secret

# ─── RabbitMQ ───────────────────────────────────────────────
RABBITMQ_USER=mcu_service
RABBITMQ_PASSWORD=mcu_mq_secret

# ─── Security (CHANGE IN PRODUCTION) ───────────────────────
JWT_SECRET=dev-jwt-secret-change-in-production
ENCRYPTION_KEY=dev-encryption-key-32ch
# ENCRYPTION_KEY_OLD=          # Previous key for rotation

# ─── LLM / AI ──────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
MOCK_MODE=false

# ─── Free Tier API (DeepSeek) ──────────────────────────────
FREE_API_KEY=
FREE_API_ENDPOINT=https://api.deepseek.com/v1/chat/completions
FREE_API_MODEL=deepseek-chat

# ─── Premium Tier API (OpenAI) ─────────────────────────────
PREMIUM_API_KEY=
PREMIUM_API_ENDPOINT=https://api.openai.com/v1/chat/completions
PREMIUM_API_MODEL=gpt-4o

# ─── Redis (optional, for production rate-limiting) ─────────
# REDIS_URL=redis://localhost:6379
