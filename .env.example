# MCU Project Assistant - Environment Configuration
# Local single-process runtime (S10 architecture: modular monolith, SQLite + workspace files).
# Use this file as a reference for your shell, service manager, or deployment secret store.
# The server does not auto-load a .env file. Set an explicit real AI provider before start;
# it fails closed when provider settings are missing and never silently falls back to mock.

# ─── HTTP Server ────────────────────────────────────────────
# MCU_PORT=3000
# MCU_HOST=127.0.0.1          # loopback-bound for local single-user (Security §5)
# MCU_DEVICE_PROVIDER=companion   # explicit deterministic companion path; physical mode is unavailable, never a fallback
# MCU_BUILD_TIMEOUT_MS=600000      # external compiler hard timeout (10 minutes)
# MCU_ARDUINO_CLI_PATH=arduino-cli  # explicit compiler executable; discovery and build use the same path

# ─── Persistence ────────────────────────────────────────────
# MCU_DB_PATH=./data/mcu.db   # SQLite database (9 tables; migrations in src/adapters/persistence/sqlite/migrations.ts)
# MCU_WORKSPACE_DIR=./workspace  # real artifact files (requirements/, firmware/<NNNN>/…, .build/, .evidence/)

# ─── AI Provider (required) ─────────────────────────────────
# Choose exactly one real provider. Mock adapters are test fixtures only.
#
# SenseNova (OpenAI-compatible; current verified local provider):
# MCU_AI_PROVIDER=sensenova
# SENSENOVA_API_KEY=
# SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
# SENSENOVA_CHAT_MODEL=deepseek-v4-flash
#
# Zhipu GLM:
# MCU_AI_PROVIDER=zhipu
# MCU_ZHIPU_API_KEY=
# MCU_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MCU_ZHIPU_CHAT_MODEL=glm-4.5-flash
